# ==============================================================================
# GestionAtelier — Variables d'environnement
# ==============================================================================
# Copier ce fichier en ".env" et renseigner toutes les valeurs avant déploiement.
# Ne jamais commiter le fichier ".env" en production (il est dans .gitignore).
# ==============================================================================


# ==============================================================================
# 🔴 OBLIGATOIRES — L'application ne démarrera PAS sans ces variables
# ==============================================================================

# Clé secrète de signature JWT (HMAC-SHA256).
# Générer avec : openssl rand -base64 48
# Contrainte    : minimum 32 caractères. Changer entre chaque client.
JWT_SECRET=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE_D_AU_MOINS_32_CARACTERES

# Clé publique RSA pour la validation des licences.
# Contenu du fichier "public.key" fourni lors de la génération de licence.
# Alternativement, placer le fichier dans : <répertoire_app>/data/public.key
LICENSE_PUBLIC_KEY=REMPLACER_PAR_LE_CONTENU_DE_public.key


# ==============================================================================
# 🟠 FORTEMENT RECOMMANDÉES — Valeurs par défaut Windows non compatibles Linux
# ==============================================================================

# Chemin racine des hotfolders de production (dossiers de flux de fichiers).
# Défaut si absent : C:\Flux  (Windows uniquement — ne pas laisser vide sur Linux)
# Exemple Linux   : /opt/gestionatelier/flux
# Exemple Windows : C:\FluxAtelier
GA_HOTFOLDERS_ROOT=C:\Flux

# Clé de chiffrement AES-256 pour les credentials des sources de commandes
# (Dropbox, Google Drive, OneDrive, Box, ERP...).
# Générer avec : openssl rand -base64 48
# Contrainte    : minimum 32 caractères.
# Si absent, une clé par défaut est utilisée avec un avertissement au démarrage.
GA_ENCRYPTION_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE_D_AU_MOINS_32_CARACTERES


# ==============================================================================
# 🟡 OPTIONNELLES — Valeurs par défaut applicables dans la plupart des cas
# ==============================================================================

# Taille maximale autorisée pour les uploads de fichiers (en Mo).
# Défaut si absent : 500 (Mo)
# Adapter selon la taille maximale des PDF attendus chez ce client.
MAX_UPLOAD_MB=500


# ==============================================================================
# 📦 MONGODB — Configuration de la base de données
# ==============================================================================
# Note : La chaîne de connexion est actuellement codée en dur dans
# Services/MongoDbHelper.cs (mongodb://localhost:27017).
# À externaliser dans une future version.
#
# En attendant, s'assurer que MongoDB est accessible sur localhost:27017
# depuis le serveur hébergeant l'application.
#
# Pour une instance distante ou sécurisée, modifier directement :
#   Services/MongoDbHelper.cs → ConnectionString
#
# Exemples de chaînes de connexion :
#   mongodb://localhost:27017
#   mongodb://user:password@192.168.1.10:27017/GestionAtelier
#   mongodb+srv://user:password@cluster.mongodb.net/GestionAtelier


# ==============================================================================
# ⚙️  ASPNETCORE — Configuration serveur (optionnel)
# ==============================================================================

# Environnement d'exécution ASP.NET Core.
# "Production" désactive les pages d'erreur détaillées.
ASPNETCORE_ENVIRONMENT=Production

# Port d'écoute HTTP (défaut dans le code : 5080).
# Modifier ici si le port est déjà utilisé sur le serveur client.
# ASPNETCORE_URLS=http://0.0.0.0:5080


# ==============================================================================
# 🗑️  CORBEILLE — Configuration via appsettings.json ou variables d'env
# ==============================================================================
# Ces paramètres peuvent aussi être définis dans appsettings.json.
# La corbeille est le dossier où les fichiers supprimés sont déplacés
# avant suppression définitive.
#
# Activer la corbeille (true/false)
# RecycleBin__Enabled=true
#
# Chemin de la corbeille (défaut : <GA_HOTFOLDERS_ROOT>/Corbeille)
# RecycleBin__Path=C:\Flux\Corbeille
#
# Nombre de jours de rétention avant suppression définitive (défaut : 7)
# RecycleBin__DaysToKeep=7


# ==============================================================================
# 📋 RÉSUMÉ CHECKLIST DÉPLOIEMENT CLIENT
# ==============================================================================
# Avant toute mise en production, vérifier :
#
# [ ] JWT_SECRET défini avec une valeur unique et aléatoire (>= 32 chars)
# [ ] LICENSE_PUBLIC_KEY défini avec la clé du client
# [ ] GA_HOTFOLDERS_ROOT pointe vers le bon répertoire sur ce serveur
# [ ] GA_ENCRYPTION_KEY défini avec une valeur unique et aléatoire (>= 32 chars)
# [ ] MongoDB est accessible (localhost:27017 ou connexion distante configurée)
# [ ] Le fichier .env n'est PAS dans le dépôt Git (.gitignore vérifié)
# [ ] ASPNETCORE_ENVIRONMENT=Production
# ==============================================================================
