<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Cible .NET -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Nommage -->
    <AssemblyName>GestionAtelier</AssemblyName>
    <RootNamespace>GestionAtelier</RootNamespace>

    <!-- Publication en mode "classique" (pas single-file) pour éviter les chemins TEMP -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Laisser le SDK inclure automatiquement wwwroot/** dans le publish -->
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <EnableDefaultStaticFileItems>true</EnableDefaultStaticFileItems>

    <!-- Globalization invariante pour réduire la surface -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Empêche le SDK d'inclure les artefacts déjà publiés comme "Content".
      Sans cela, publier dans ./publish/GestionAtelier (sous le projet) fait que
      les globs par défaut (**/*.json, **/web.config, ...) capturent les fichiers
      d'une publication précédente, ce qui provoque des chemins dupliqués
      (publish\GestionAtelier\publish\GestionAtelier\...) et l'erreur MSB3030
      "Impossible de copier ... GestionAtelier.deps.json, car il est introuvable".
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;installer\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- ✅ Inclure wwwroot_portal et wwwroot_pro dans le publish -->
  <ItemGroup>
    <Content Include="wwwroot_portal\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="wwwroot_pro\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- ✅ Copier data/public.key vers le dossier output (data\public.key) -->
  <ItemGroup>
    <None Include="data\public.key" Condition="Exists('data\public.key')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>data\public.key</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Box.V2.Core" Version="5.2.0" />
    <PackageReference Include="Dropbox.Api" Version="7.0.0" />
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.68.0.3466" />
    <PackageReference Include="Microsoft.Graph" Version="5.65.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.7.1" />
    <PackageReference Include="itext7" Version="8.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2024.3.1" />
    <PackageReference Include="Standard.Licensing" Version="1.1.1" />
    <PackageReference Include="MailKit" Version="4.9.0">
      <!-- GHSA-9j88-vvj5-vhgr is fixed in MailKit ≥ 4.7.0; NuGet audit data may lag behind. -->
      <NoWarn>NU1902</NoWarn>
    </PackageReference>
    <PackageReference Include="SSH.NET" Version="2024.2.0" />
  </ItemGroup>
</Project>
